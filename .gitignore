# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# TeraFold runtime artifacts (regenerable — never commit)
runs/
*.pt
*.ckpt
*.safetensors
*.mp4
# Archive snapshots (the 424 MB / 1.4 GB dataset tarballs exceed GitHub's limit;
# code tarballs duplicate what git already tracks)
*.tar.gz

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Keep small sample/config assets if explicitly added with `git add -f`
!configs/*.yaml

# Vendored SDKs / virtualenvs (machine-specific; loaded by local path)
vendor/

# ---- TeraFold runtime artifacts / datasets ----
/data/
runs/
tera_checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.mp4
*.usd
