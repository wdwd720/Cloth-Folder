# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# TeraFold runtime artifacts (large / regenerable — never commit)
# /data holds raw/generated datasets (GBs); GitHub caps files at 100 MB anyway.
# (anchored to repo root so terafold/data — a Python package — stays tracked)
/data/
runs/
*.pt
*.ckpt
*.safetensors
*.mp4
# Archive snapshots (the 424 MB / 1.4 GB dataset tarballs exceed GitHub's limit;
# code tarballs duplicate what git already tracks)
*.tar.gz

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Keep small sample/config assets if explicitly added with `git add -f`
!configs/*.yaml

# Vendored SDKs / virtualenvs (machine-specific; loaded by local path)
vendor/
